# ═══════════════════════════════════════════
#   🤖 СЕКОНД-ХЕНД: ВЕБ-ВЕРСИЯ
#   Настройки для .env
# ═══════════════════════════════════════════

# ───────── ДЛЯ RENDER (Environment Variables в Dashboard) ─────────
# Все переменные ниже можно задать в Render Dashboard:
# https://dashboard.render.com/ → ваш сервис → Environment

# Обязательно придумать свой секретный ключ
FLASK_SECRET_KEY=change-this-to-random-string

# Если указать — сайт спросит пароль при входе
WEB_PASSWORD=

# AI: YandexGPT (опционально)
AI_PROVIDER=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Google Sheets (опционально, нужен credentials.json)
GOOGLE_SHEETS_ID=